home_matches <- domestic_clean %>%

  transmute(

    Date,
    country,
    season_code,

    team = HomeTeam,
    opponent = AwayTeam,

    home = 1,

    goals_for = home_goals,
    goals_against = away_goals,

    shots_for = HS,
    shots_against = AS,

    shots_on_target_for = HST,
    shots_on_target_against = AST,

    corners_for = HC,
    corners_against = AC,

    result = case_when(
      home_goals > away_goals ~ "Win",
      home_goals == away_goals ~ "Draw",
      TRUE ~ "Loss"
    ),

    points = case_when(
      home_goals > away_goals ~ 3,
      home_goals == away_goals ~ 1,
      TRUE ~ 0
    )
  )


away_matches <- domestic_clean %>%

  transmute(

    Date,
    country,
    season_code,

    team = AwayTeam,
    opponent = HomeTeam,

    home = 0,

    goals_for = away_goals,
    goals_against = home_goals,

    shots_for = AS,
    shots_against = HS,

    shots_on_target_for = AST,
    shots_on_target_against = HST,

    corners_for = AC,
    corners_against = HC,

    result = case_when(
      away_goals > home_goals ~ "Win",
      away_goals == home_goals ~ "Draw",
      TRUE ~ "Loss"
    ),

    points = case_when(
      away_goals > home_goals ~ 3,
      away_goals == home_goals ~ 1,
      TRUE ~ 0
    )
  )


team_matches <- bind_rows(
  home_matches,
  away_matches
) %>%

  arrange(
    team,
    Date
  )

#| label: rolling-form

team_matches <- team_matches %>%

  group_by(team) %>%

  arrange(
    Date,
    .by_group = TRUE
  ) %>%

  mutate(

    matches_before = row_number() - 1,

    form_points_5 = lag(
      slide_dbl(
        points,
        mean,
        .before = 4,
        .complete = FALSE
      )
    ),

    form_goals_for_5 = lag(
      slide_dbl(
        goals_for,
        mean,
        .before = 4,
        .complete = FALSE
      )
    ),

    form_goals_against_5 = lag(
      slide_dbl(
        goals_against,
        mean,
        .before = 4,
        .complete = FALSE
      )
    )

  ) %>%

  mutate(

    form_goal_difference_5 =
      form_goals_for_5 -
      form_goals_against_5

  ) %>%

  ungroup()

#| label: elo-ratings

team_names <- unique(
  c(
    domestic_clean$HomeTeam,
    domestic_clean$AwayTeam
  )
)

elo_ratings <- setNames(
  rep(1500, length(team_names)),
  team_names
)

elo_history <- vector(
  "list",
  nrow(domestic_clean)
)

elo_k <- 20

home_advantage <- 60

#| label: calculate-elo

for (i in seq_len(nrow(domestic_clean))) {

  home_team <- domestic_clean$HomeTeam[i]

  away_team <- domestic_clean$AwayTeam[i]

  home_elo <- elo_ratings[home_team]

  away_elo <- elo_ratings[away_team]


  # Save ratings before the match

  elo_history[[i]] <- data.frame(

    Date = domestic_clean$Date[i],

    HomeTeam = home_team,

    AwayTeam = away_team,

    home_elo = home_elo,

    away_elo = away_elo

  )


  # Expected home result

  expected_home <- 1 / (
    1 +
      10 ^ (
        (
          away_elo -
            (
              home_elo +
                home_advantage
            )
        ) / 400
      )
  )


  # Actual result

  actual_home <- case_when(

    domestic_clean$home_goals[i] >
      domestic_clean$away_goals[i] ~ 1,

    domestic_clean$home_goals[i] ==
      domestic_clean$away_goals[i] ~ 0.5,

    TRUE ~ 0

  )


  # Update Elo

  change <- elo_k * (
    actual_home -
      expected_home
  )


  elo_ratings[home_team] <-
    home_elo + change

  elo_ratings[away_team] <-
    away_elo - change
}


elo_history <- bind_rows(
  elo_history
)

#| label: add-elo

domestic_model_data <- domestic_clean %>%

  left_join(
    elo_history,
    by = c(
      "Date",
      "HomeTeam",
      "AwayTeam"
    )
  ) %>%

  mutate(

    elo_difference =
      home_elo -
      away_elo

  )

#| label: home-form

home_features <- team_matches %>%

  filter(home == 1) %>%

  select(

    Date,
    country,
    season_code,

    HomeTeam = team,

    home_form_points_5 =
      form_points_5,

    home_form_goals_for_5 =
      form_goals_for_5,

    home_form_goals_against_5 =
      form_goals_against_5,

    home_form_goal_difference_5 =
      form_goal_difference_5

