    Date,
    country,
    season_code,

    AwayTeam = team,

    away_form_points_5 =
      form_points_5,

    away_form_goals_for_5 =
      form_goals_for_5,

    away_form_goals_against_5 =
      form_goals_against_5,

    away_form_goal_difference_5 =
      form_goal_difference_5

