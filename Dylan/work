#| label: download-function

download_league <- function(country, league_code, season) {

  url <- paste0(
    "https://www.football-data.co.uk/mmz4281/",
    season,
    "/",
    league_code,
    ".csv"
  )

  data <- tryCatch(
    read_csv(
      url,
      # Force Date to stay as plain character on read. Without this,
      # readr guesses each column's type per-file (based on a sample
      # of that file's own rows), so some season files get Date
      # auto-parsed into a real Date class while others don't -
      # depending on how ambiguous that file's 2-digit years looked.
      # Binding ~80 files together with mismatched types then produces
      # exactly the inconsistent "10-12-22" vs "10-12-2022" mix seen
      # downstream. Keeping Date as character here means our explicit
      # lubridate::dmy() call later is the ONLY place parsing happens,
      # applied uniformly across every row at once.
      col_types = cols(
        Date = col_character(),
        .default = col_guess()
      ),
      show_col_types = FALSE
    ),
    error = function(e) {
      message(
        "Could not download: ",
        country,
        " ",
        season
      )
      return(NULL)
    }
  )

  if (is.null(data)) {
    return(NULL)
  }

  data$country <- country
  data$season_code <- season

  data
}

#| label: download-data
#| cache: true

domestic_results <- map_dfr(
  names(leagues),
  function(country) {

    map_dfr(
      seasons,
      function(season) {

        download_league(
          country,
          leagues[[country]],
          season
        )
      }
    )
  }
)

dim(domestic_results)

#| label: raw-date-check

# Confirm Date came through as plain character (not already a mix of
# Date/character types from readr's per-file guessing) before we do
# our own single parsing pass below.
cat("Class of raw Date column:", class(domestic_results$Date), "\n")

# Peek at a sample of the actual raw text formats present.
domestic_results %>%
  distinct(Date) %>%
  slice_sample(n = 10)

#| label: clean-data

# NOTE ON DATES: football-data.co.uk changed its Date format partway
# through its history - older season files use dd/mm/yy (2-digit
# year), newer ones use dd/mm/yyyy (4-digit year). Parsing everything
# with a single as.Date(Date, format = "%d/%m/%Y") silently mis-reads
# 2-digit years literally (e.g. "10" becomes year 10 AD, not 2010),
# which is why dates were showing up as 0010-01-29 etc. lubridate::dmy()
# auto-detects both 2-digit and 4-digit years correctly (00-68 -> 2000s,
# 69-99 -> 1900s), so it handles the mixed formats across seasons
# without needing to know which seasons use which.
domestic_clean <- domestic_results %>%

  mutate(

    Date = lubridate::dmy(Date),

    home_goals = as.numeric(FTHG),

    away_goals = as.numeric(FTAG),

    result = case_when(
      FTR == "H" ~ "Home",
      FTR == "D" ~ "Draw",
      FTR == "A" ~ "Away",
      TRUE ~ NA_character_
    ),

    HS = as.numeric(HS),
    AS = as.numeric(AS),
    HST = as.numeric(HST),
    AST = as.numeric(AST),
    HC = as.numeric(HC),
    AC = as.numeric(AC)

  ) %>%

  select(
    Date,
    country,
    season_code,
    HomeTeam,
    AwayTeam,
    home_goals,
    away_goals,
    result,
    HS,
    AS,
    HST,
    AST,
    HC,
    AC
  ) %>%

  filter(
    !is.na(Date),
    !is.na(home_goals),
    !is.na(away_goals)
  ) %>%

  arrange(Date)

#| label: date-sanity-check

# Sanity check the fix: date range should now be a sensible span
# (e.g. "2010-08-14" to "2026-05-XX"), with no absurd years like 0010.
cat(
  "Date range:",
  as.character(min(domestic_clean$Date, na.rm = TRUE)),
  "to",
  as.character(max(domestic_clean$Date, na.rm = TRUE)),
  "\n"
)

# Check whether the reparse introduced any NA dates (rows where
# lubridate::dmy() couldn't recognize the format at all - safer than
# a silently wrong date, but worth confirming nothing got dropped).
cat(
  "Rows with unparseable dates (NA):",
  sum(is.na(domestic_results$Date) == FALSE & is.na(lubridate::dmy(domestic_results$Date))),
  "\n"
)

# Confirm every date now renders with a full 4-digit year, with no
# leftover 2-digit-year rows. Date is a proper R Date class at this
# point (stored as days-since-1970, not text), so format() always
# renders every row the same way regardless of how the original raw
# string looked (e.g. "20/01/18" vs "24/11/2018") - this check should
# always return 0 rows once lubridate::dmy() has been applied.
domestic_clean %>%
  mutate(year_check = format(Date, "%Y")) %>%
  filter(nchar(year_check) != 4) %>%
  nrow() %>%
  { cat("Rows with non-4-digit year after formatting:", ., "\n") }

